# Copy to .env and fill in to use the Supabase backend.
# Without these the app runs on the bundled demo catalog (mock provider),
# clearly labeled "Demo product data" in the UI.
#
# The anon key is a *publishable* key: it is safe to embed in the app and is
# restricted to read-only catalog access by row-level security. Never put the
# service_role key (or any other secret) in this file or in the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-side secrets — NEVER here, never EXPO_PUBLIC_, never in the bundle.
# Set them as Supabase Edge Function secrets instead:
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...     # console.anthropic.com
#   supabase secrets set ANTHROPIC_MODEL=claude-opus-5     # optional override
#
# SUPABASE_SERVICE_ROLE_KEY is provided to Edge Functions automatically by
# the platform; for the import CLI (scripts/import-catalog.mjs) export it in
# the operator's shell only.
# ---------------------------------------------------------------------------
