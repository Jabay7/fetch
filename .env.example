# Copy to .env and fill in to use the Supabase backend.
# Without these the app runs on the bundled demo catalog (mock provider).
#
# The anon key is a *publishable* key: it is safe to embed in the app and is
# restricted to read-only catalog access by row-level security. Never put the
# service_role key (or any other secret) in this file or in the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
